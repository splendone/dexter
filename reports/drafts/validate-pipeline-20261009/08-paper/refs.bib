% refs.bib — 占位骨架。构建规范见 ../refs-bib-guide.md(零虚构引用)。
% 每条 bibkey 必须回指语料清单里一条「已开原文」记录;有正式版的用正式版,非 arXiv 预印本。
% 下面为格式示例,正式写作时替换为真实、已核对的条目。

@inproceedings{EXAMPLE2024method,
  author    = {Lastname, Firstname and Lastname2, Firstname2},
  title     = {Example Paper Title (replace with a real, verified entry)},
  booktitle = {Proceedings of the Conference on Robot Learning (CoRL)},
  year      = {2024},
  note      = {EXAMPLE ONLY -- arXiv:0000.00000; verified via curl on YYYY-MM-DD}
}

@article{EXAMPLE2023journal,
  author  = {Lastname, Firstname},
  title   = {Example Journal Article (replace)},
  journal = {IEEE Transactions on Robotics},
  year    = {2023},
  volume  = {39},
  number  = {1},
  pages   = {1--20},
  doi     = {10.1109/TRO.2023.0000000},
  note    = {EXAMPLE ONLY}
}
