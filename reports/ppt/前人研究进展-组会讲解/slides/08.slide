                        <Text style={{ fontSize: 15, color: '#1A2230' }}>● 76k 条轨迹</Text>
                    </Box>
                    <Box style={{ width: 126, alignItems: 'center', justifyContent: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#1A2230' }}>● 100–4000</Text>
