<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
    <Box style={{ width: 1280, height: 720, flexDirection: 'column' }}>
        <Box style={{ width: 1280, height: 10, background: '#0E3F8C' }} />

        <Box style={{ width: 1280, height: 512, flexDirection: 'row', padding: '26px 96px 0 96px' }}>
            <Box style={{ width: 300, height: 486, background: '#F7F9FC', padding: '24px 22px', flexDirection: 'column', justifyContent: 'space-between' }}>
                <Box style={{ flexDirection: 'column' }}>
                    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#0E3F8C', lineHeight: 1.35 }}>
                        谁调过
                        <br />
                        哪一根轴
                    </Text>
                    <Box style={{ width: 44, height: 3, background: '#1E4FA8', marginTop: 14 }} />
                    <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.65, marginTop: 16 }}>
                        八项代表工作摊开看。前四列是自变量，最后一列是它要不要为每个新任务付训练成本。
                    </Text>
                </Box>

                <Box style={{ background: '#FFFFFF', borderLeft: '3px solid #FFC107', padding: '12px 14px' }}>
                    <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.7 }}>
                        读法提示：RoboTTT 那一格的 128 – 8000 是训练时的序列长度，不是检索条数，别和上面几行混着读。
                    </Text>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 8 }}>
                    <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                        <Text style={{ width: 26, fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>●</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568' }}>系统扫过这根轴</Text>
                    </Box>
                    <Box style={{ flexDirection: 'row', alignItems: 'center' }}>
                        <Text style={{ width: 26, fontSize: 18, color: '#8B97A8' }}>—</Text>
                        <Text style={{ fontSize: 15, color: '#4A5568' }}>固定不动或没有这根轴</Text>
                    </Box>
                </Box>
            </Box>

            <Box style={{ flex: 1, paddingLeft: 28, height: 486, flexDirection: 'column' }}>
                <Box style={{ width: 760, height: 46, flexDirection: 'row', background: '#0E3F8C' }}>
